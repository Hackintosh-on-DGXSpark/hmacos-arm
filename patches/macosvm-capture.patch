diff --git a/macosvm/main.m b/macosvm/main.m
index 8f50734..4fb1f1f 100644
--- a/macosvm/main.m
+++ b/macosvm/main.m
@@ -12,6 +12,7 @@ static const char *version = "0.2-3";
     VMSpec *spec;
     NSTimer *installProgressTimer;
     int tick;
+    int captureCount;
 }
 
 @property BOOL useGUI;
@@ -95,6 +96,36 @@ attachmentWasDisconnectedWithError:(NSError *)error {
     if (self.useGUI) [self startApp];
 }
 
+- (void) captureGuestView: (id) unused {
+    NSString *directory = NSProcessInfo.processInfo.environment[@"HMACOS_CAPTURE_DIR"];
+    NSBitmapImageRep *bitmap = [view bitmapImageRepForCachingDisplayInRect:view.bounds];
+    if (!directory || !bitmap) {
+        NSLog(@"Guest capture failed: no directory or bitmap");
+        exit(1);
+    }
+    [view cacheDisplayInRect:view.bounds toBitmapImageRep:bitmap];
+    NSData *png = [bitmap representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
+    NSString *path = [directory stringByAppendingPathComponent:
+                     [NSString stringWithFormat:@"guest-%03d.png", ++captureCount * 30]];
+    NSError *error = nil;
+    if (!png || ![png writeToFile:path options:NSDataWritingAtomic error:&error]) {
+        NSLog(@"Guest capture failed: %@", error);
+        exit(1);
+    }
+    NSLog(@"Guest-only capture saved: %@", path);
+    if (captureCount < 4) {
+        [self performSelector:@selector(captureGuestView:) withObject:nil afterDelay:30.0];
+    } else {
+        dispatch_async(vm->queue, ^{
+            [vm.virtualMachine stopWithCompletionHandler:^(NSError *stopError) {
+                NSLog(@"Bounded validation VM stopped: %@", stopError ? stopError : @"OK");
+                [NSApp performSelectorOnMainThread:@selector(terminate:)
+                                       withObject:self waitUntilDone:NO];
+            }];
+        });
+    }
+}
+
 - (void) updateProgess: (id) object {
     const char ticks[] = "-\\|/";
 #ifdef MACOS_GUEST
@@ -239,6 +270,8 @@ attachmentWasDisconnectedWithError:(NSError *)error {
 #endif
             NSLog(@"Starting instance...");
             [vm start];
+            if (self.useGUI && NSProcessInfo.processInfo.environment[@"HMACOS_CAPTURE_DIR"])
+                [self performSelector:@selector(captureGuestView:) withObject:nil afterDelay:30.0];
 #ifdef MACOS_GUEST
         }
 #endif
